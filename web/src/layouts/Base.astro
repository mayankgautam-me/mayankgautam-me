---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  /** The page's path as Cloudflare serves it (html_handling auto-trailing-slash): '/', '/about', '/pages/portfolio/x'. The files are about.html and so on, so the old .html URLs still resolve. */
  path: string;
  /** Which nav entry is current; defaults to path. */
  section?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title, description, path, section = path, type = 'website', noindex = false } = Astro.props;
const canonical = new URL(path, SITE.url).href;
const fullTitle = path === '/' ? `${SITE.name}, embedded engineer` : `${title} · ${SITE.name}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="color-scheme" content="dark light" />
  <meta name="theme-color" content="#1a1b26" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#e1e2e7" media="(prefers-color-scheme: light)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: blog`} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_IN" />
  <meta name="twitter:card" content="summary" />
  <meta name="generator" content={Astro.generator} />
  <script is:inline>
    // The theme toggle's choice (light or dark), applied before first paint so the page never flashes
    // the other theme. No choice, or no storage, follows the system setting.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    })();
  </script>
  <script is:inline>
    // Scroll reveal is an enhancement: content stays visible unless all of these hold.
    (function () {
      var d = document.documentElement;
      if ('IntersectionObserver' in window && document.visibilityState === 'visible' &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('reveal-on');
    })();
  </script>
  <!-- Links swap the page in place: this page keeps running while the next one loads, so the load bar
       can move from the click to the swap (a full page load freezes the old page's last frame). -->
  <ClientRouter />
  <slot name="head" />
</head>
<body>
  <div class="loadbar" aria-hidden="true" transition:persist="loadbar"></div>
  <a class="skip" href="#main">Skip to content</a>
  <div class="mesh" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="grain" aria-hidden="true"></div>
  <Nav current={section} />
  <main class="wrap" id="main">
    <slot />
    <Footer />
  </main>
  <script>
    // This module runs once; the client router then swaps each page's body in place. Listeners therefore
    // sit on the document (they survive swaps), and anything about the current page runs on astro:page-load.
    const root = document.documentElement;

    // Menu (mobile)
    const setMenu = (open: boolean) => {
      const burger = document.getElementById('burger');
      document.body.classList.toggle('menu-open', open);
      burger?.setAttribute('aria-expanded', String(open));
      burger?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) document.getElementById('sheet')?.querySelector('a')?.focus({ preventScroll: true });
    };
    document.addEventListener('click', (e) => {
      const t = e.target as Element | null;
      if (t?.closest?.('#burger')) setMenu(!document.body.classList.contains('menu-open'));
      else if (t?.closest?.('#sheet a')) setMenu(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.body.classList.contains('menu-open')) { setMenu(false); document.getElementById('burger')?.focus(); }
    });
    matchMedia('(min-width: 861px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

    // Load bar: starts the moment a link is followed and grows while the next page loads; once the new
    // page is swapped in it fills and fades. It stays at least 300 ms so a cached page still shows it.
    let startedAt = 0;
    let finishTimer = 0;
    const bar = () => document.querySelector<HTMLElement>('.loadbar');
    document.addEventListener('astro:before-preparation', () => {
      const el = bar(); if (!el) return;
      clearTimeout(finishTimer);
      el.removeAttribute('style');
      el.classList.remove('go'); void el.offsetWidth; el.classList.add('go');
      startedAt = performance.now();
    });
    // The swap moves the bar into the new page, which would restart its CSS animation from the beginning:
    // hold its current width across the swap instead.
    let heldAt = '';
    document.addEventListener('astro:before-swap', () => {
      const el = bar(); if (el?.classList.contains('go')) heldAt = getComputedStyle(el).transform;
    });
    document.addEventListener('astro:after-swap', () => {
      const el = bar(); if (!el || !heldAt) return;
      el.style.animation = 'none';
      el.style.transform = heldAt;
      heldAt = '';
    });
    document.addEventListener('astro:page-load', () => {
      const el = bar(); if (!el || !el.classList.contains('go')) return;
      const wait = Math.max(0, 300 - (performance.now() - startedAt));
      finishTimer = window.setTimeout(() => {
        el.style.transform = getComputedStyle(el).transform;
        el.style.animation = 'none';
        void el.offsetWidth;
        el.style.transition = 'transform 0.25s ease-out, opacity 0.35s ease 0.2s';
        el.style.transform = 'scaleX(1)';
        el.style.opacity = '0';
        finishTimer = window.setTimeout(() => { el.classList.remove('go'); el.removeAttribute('style'); }, 650);
      }, wait);
    });

    // Theme toggle: system -> light -> dark -> system. The browser's own UI colour follows the choice.
    const themeColor = { light: '#e1e2e7', dark: '#1a1b26' } as const;
    const next = { system: 'light', light: 'dark', dark: 'system' } as const;
    type Mode = keyof typeof next;
    const savedMode = (): Mode => {
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') return t; } catch {}
      return 'system';
    };
    const applyTheme = (mode: Mode) => {
      if (mode === 'system') delete root.dataset.theme; else root.dataset.theme = mode;
      document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
        const own = m.media.includes('light') ? themeColor.light : themeColor.dark;
        m.content = mode === 'system' ? own : themeColor[mode];
      });
      const btn = document.getElementById('theme');
      if (btn) {
        btn.dataset.mode = mode;
        btn.setAttribute('aria-label', `Theme: ${mode}. Switch to ${next[mode]}`);
        btn.title = `Theme: ${mode}`;
      }
    };
    // A swap replaces <html>'s attributes with the new page's, so the choice is put back before it paints.
    document.addEventListener('astro:after-swap', () => applyTheme(savedMode()));
    document.addEventListener('astro:page-load', () => applyTheme(savedMode()));
    document.addEventListener('click', (e) => {
      const btn = (e.target as Element | null)?.closest?.<HTMLElement>('#theme');
      if (!btn) return;
      const mode = next[(btn.dataset.mode as Mode) || 'system'];
      try { if (mode === 'system') localStorage.removeItem('theme'); else localStorage.setItem('theme', mode); } catch {}
      applyTheme(mode);
    });

    // Scroll reveal, on the first page only (the head script sets .reveal-on there). Pages reached by a
    // link show their content at once, since a swap drops .reveal-on.
    if (root.classList.contains('reveal-on')) {
      const items = document.querySelectorAll('.rv');
      const showAll = () => { items.forEach((el) => el.classList.add('in')); io.disconnect(); };
      const seen = new WeakSet<Element>();
      let reported = 0;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!seen.has(e.target)) { seen.add(e.target); reported++; }
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0, rootMargin: '0px 0px -8% 0px' });
      items.forEach((el) => io.observe(el));
      // The observer reports every element once right after observe(). If it has not within
      // 1.5 s (a throttled or headless renderer), it cannot be trusted to reveal: show everything.
      setTimeout(() => { if (reported < items.length) showAll(); }, 1500);
      // Never leave content hidden: a tab sent to the background, a print or a swap shows everything.
      document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') showAll(); });
      window.addEventListener('beforeprint', showAll);
      document.addEventListener('astro:before-swap', showAll, { once: true });
    }
  </script>
</body>
</html>
