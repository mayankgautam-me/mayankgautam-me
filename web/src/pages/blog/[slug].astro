---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={d.title} path={`/blog/${post.id}`} section="/blog" description={d.description} type="article">
  <meta slot="head" property="article:published_time" content={d.date.toISOString()} />
  <header class="page-head">
    <div>
      <a class="eyebrow rv" href="/blog"><b></b>Blog</a>
      <h1 class="rv d1" style="font-size:clamp(40px,5vw,72px)">{d.title}</h1>
    </div>
    <div class="rv d2">
      <p class="lede">{d.description}</p>
      {d.draft && <p class="draft-note">Draft: this post is not final yet and may change.</p>}
    </div>
  </header>

  <section class="block tight">
    <div class="article">
      <div class="aside rv">
        <div class="meta">
          <div><small class="mono">Published</small><span><time datetime={d.date.toISOString().slice(0, 10)}>{date}</time></span></div>
          <div><small class="mono">By</small><span>Mayank Gautam</span></div>
        </div>
        {d.tags.length > 0 && <div class="tags" style="padding-top:0">{d.tags.map((t) => <span>{t}</span>)}</div>}
      </div>
      <article class="prose rv d1"><Content /></article>
    </div>
  </section>
</Base>
