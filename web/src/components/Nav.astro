---
import { NAV, SITE } from '../data/site';
interface Props { current: string }
const { current } = Astro.props;
const isCurrent = (href: string) => href === current;
---
<header class="nav" id="nav">
  <a class="brand" href="/"><b aria-hidden="true"></b>{SITE.name}</a>
  <nav aria-label="Main">
    <ul>
      {NAV.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>
  <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet"><span></span><span></span></button>
</header>
<nav class="sheet" id="sheet" aria-label="Menu">
  {NAV.map((n, i) => (
    <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}><span><small class="mono">{String(i + 1).padStart(2, '0')}</small>{n.label}</span></a>
  ))}
  <p class="sheet-foot mono">{SITE.place} · {SITE.email}</p>
</nav>
