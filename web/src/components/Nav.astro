---
import { NAV, SITE } from '../data/site';
interface Props { current: string }
const { current } = Astro.props;
const isCurrent = (href: string) => href === current;
---
<header class="nav" id="nav">
  <a class="brand" href="/"><svg class="mark" viewBox="8.66 17.00 46.68 30.00" aria-hidden="true" focusable="false"><defs><linearGradient id="mg-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" style="stop-color: var(--blue)" /><stop offset=".6" style="stop-color: var(--magenta)" /><stop offset="1" style="stop-color: var(--teal)" /></linearGradient></defs><g transform="translate(11.16 -0.50)" fill="none" stroke-width="5.0" stroke-linecap="round" stroke-linejoin="round"><path d="M0.00 45.00V20.00L12.00 32.00L20.34 23.66" stroke="currentColor" /><path d="M38.75 24.47A12.5 12.5 0 1 0 41.68 32.50H31.18" stroke="url(#mg-g)" /></g></svg>{SITE.name}</a>
  <nav aria-label="Main">
    <ul>
      {NAV.map((n) => <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
    </ul>
  </nav>
  <button class="theme" id="theme" type="button" data-mode="system" aria-label="Theme: system. Switch to light">
    <svg class="i-system" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><rect x="1.75" y="2.75" width="12.5" height="8.5" rx="1.5"/><path d="M5.5 13.75h5M8 11.25v2.5"/></svg>
    <svg class="i-light" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="2.9"/><path d="M8 1.5v1.4M8 13.1v1.4M1.5 8h1.4M13.1 8h1.4M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1"/></svg>
    <svg class="i-dark" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"/></svg>
  </button>
  <button class="burger" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sheet"><span></span><span></span></button>
</header>
<nav class="sheet" id="sheet" aria-label="Menu">
  {NAV.map((n, i) => (
    <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}><span><small class="mono">{String(i + 1).padStart(2, '0')}</small>{n.label}</span></a>
  ))}
  <p class="sheet-foot mono">{SITE.place} · {SITE.email}</p>
</nav>
